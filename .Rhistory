# ============================================================
# MS6071 Project: Used Car Price Analysis
# Research question:
# How do mileage and car age affect used car selling prices?
# ============================================================
# ============================================================
# PART 1: Load packages
# ============================================================
library(tidyverse)
library(scales)
# ============================================================
# PART 2: Import the dataset
# ============================================================
cars <- read_csv(
"C:/Users/22305319/OneDrive - University of Limerick/Year5/MS6071/Car details v3.csv",
show_col_types = FALSE
)
# ============================================================
# PART 1: Load packages
# ============================================================
library(tidyverse)
library(scales)
# ============================================================
# PART 2: Import the dataset
# ============================================================
cars <- read_csv(
"C:/Users/a2871/OneDrive - University of Limerick/Year5/MS6071/Car details v3.csv",
show_col_types = FALSE
)
# Inspect the dataset
head(cars)
dim(cars)
names(cars)
glimpse(cars)
# ============================================================
# PART 3: Check missing values and duplicates
# ============================================================
colSums(is.na(cars))
# Count duplicated rows
sum(duplicated(cars))
# Summary of original variables
summary(cars)
# ============================================================
# PART 4: Clean and convert variables
# ============================================================
cars <- cars |>
mutate(
mileage_num = as.numeric(
str_remove(mileage, "\\s*(kmpl|km/kg)")
),
engine_num = as.numeric(
str_remove(engine, "\\s*CC")
),
power_num = as.numeric(
str_remove(max_power, "\\s*bhp")
)
)
# Check the converted variables
summary(cars$mileage_num)
summary(cars$engine_num)
summary(cars$power_num)
# Check missing values after conversion
colSums(is.na(cars[c(
"mileage_num",
"engine_num",
"power_num"
)]))
# ============================================================
# PART 5: Prepare data for regression
# ============================================================
# The dataset's latest model year is expected to be around 2020.
# Use 2020 as the reference year for car age.
# If your dataset covers a different listing year, change this.
reference_year <- 2020
cars_model <- cars |>
mutate(
car_age = reference_year - year
) |>
filter(
!is.na(selling_price),
!is.na(km_driven),
!is.na(year),
selling_price > 0,
km_driven >= 0,
year >= 1900,
year <= reference_year,
car_age >= 0
) |>
mutate(
mileage_group = factor(
ntile(km_driven, 3),
levels = 1:3,
labels = c(
"Low Mileage",
"Medium Mileage",
"High Mileage"
)
)
)
# Check the cleaned dataset
dim(cars_model)
summary(cars_model[, c(
"selling_price",
"km_driven",
"car_age"
)])
# Number of records removed during cleaning
nrow(cars) - nrow(cars_model)
# ============================================================
# PART 6: Exploratory Data Analysis
# ============================================================
# Plot 1: Distribution of selling prices
ggplot(cars_model, aes(x = selling_price)) +
geom_histogram(bins = 30, colour = "white") +
scale_x_continuous(labels = label_comma()) +
coord_cartesian(xlim = c(0, 2000000)) +
labs(
title = "Distribution of Used Car Selling Prices",
subtitle = "Prices above ₹2,000,000 are outside the displayed range",
x = "Selling Price (₹)",
y = "Number of Cars"
) +
theme_minimal()
# Plot 2: Distance travelled versus selling price
ggplot(cars_model, aes(
x = km_driven,
y = selling_price
)) +
geom_point(alpha = 0.3) +
scale_x_continuous(labels = label_comma()) +
scale_y_continuous(labels = label_comma()) +
coord_cartesian(
xlim = c(0, 300000),
ylim = c(0, 2000000)
) +
labs(
title = "Mileage vs Used Car Selling Price",
subtitle = "Each point represents one car",
x = "Distance Travelled (km)",
y = "Selling Price (₹)"
) +
theme_minimal()
# Plot 3: Car age versus selling price
ggplot(cars_model, aes(
x = car_age,
y = selling_price
)) +
geom_point(alpha = 0.3) +
scale_y_continuous(labels = label_comma()) +
coord_cartesian(ylim = c(0, 2000000)) +
labs(
title = "Car Age vs Used Car Selling Price",
subtitle = paste("Car age calculated relative to", reference_year),
x = "Car Age (years)",
y = "Selling Price (₹)"
) +
theme_minimal()
# Plot 4: Selling price by mileage group
ggplot(cars_model, aes(
x = mileage_group,
y = selling_price
)) +
geom_boxplot(outlier.alpha = 0.2) +
scale_y_continuous(labels = label_comma()) +
coord_cartesian(ylim = c(0, 2000000)) +
labs(
title = "Selling Price by Mileage Group",
subtitle = "Groups contain approximately equal numbers of cars",
x = "Mileage Group",
y = "Selling Price (₹)"
) +
theme_minimal()
# ============================================================
# PART 7: Regression Model 1
# Selling price predicted by distance travelled
# ============================================================
model1 <- lm(
selling_price ~ km_driven,
data = cars_model
)
# Full regression results
summary(model1)
# Plot 5: Model 1 regression line
ggplot(cars_model, aes(
x = km_driven,
y = selling_price
)) +
geom_point(alpha = 0.25) +
geom_smooth(
method = "lm",
formula = y ~ x,
se = TRUE
) +
scale_x_continuous(labels = label_comma()) +
scale_y_continuous(labels = label_comma()) +
coord_cartesian(
xlim = c(0, 300000),
ylim = c(0, 2000000)
) +
labs(
title = "Model 1: Mileage and Selling Price",
subtitle = "Simple linear regression",
x = "Distance Travelled (km)",
y = "Selling Price (₹)"
) +
theme_minimal()
# ============================================================
# PART 8: Regression Model 2
# Selling price predicted by mileage and car age
# ============================================================
model2 <- lm(
selling_price ~ km_driven + car_age,
data = cars_model
)
# Full regression results
summary(model2)
# Plot 6: Car age regression trend
ggplot(cars_model, aes(
x = car_age,
y = selling_price
)) +
geom_point(alpha = 0.25) +
geom_smooth(
method = "lm",
formula = y ~ x,
se = TRUE
) +
scale_y_continuous(labels = label_comma()) +
coord_cartesian(ylim = c(0, 2000000)) +
labs(
title = "Car Age and Selling Price",
subtitle = "Simple trend shown for visualisation",
x = "Car Age (years)",
y = "Selling Price (₹)"
) +
theme_minimal()
# ============================================================
# PART 9: Compare Model 1 and Model 2
# ============================================================
model_comparison <- tibble(
Model = c(
"Model 1: Mileage only",
"Model 2: Mileage + Car Age"
),
R_squared = c(
summary(model1)$r.squared,
summary(model2)$r.squared
),
Adjusted_R_squared = c(
summary(model1)$adj.r.squared,
summary(model2)$adj.r.squared
),
Residual_SE = c(
summary(model1)$sigma,
summary(model2)$sigma
),
AIC = c(
AIC(model1),
AIC(model2)
),
BIC = c(
BIC(model1),
BIC(model2)
)
)
print(model_comparison)
# Plot 7: R-squared comparison
comparison_long <- model_comparison |>
select(Model, R_squared, Adjusted_R_squared) |>
pivot_longer(
cols = c(R_squared, Adjusted_R_squared),
names_to = "Metric",
values_to = "Value"
)
ggplot(comparison_long, aes(
x = Model,
y = Value,
fill = Metric
)) +
geom_col(position = "dodge") +
scale_y_continuous(
labels = label_percent(),
limits = c(0, NA)
) +
labs(
title = "Comparison of Model Fit",
x = "Regression Model",
y = "R-squared",
fill = "Metric"
) +
theme_minimal()
# Plot 8: AIC comparison
ggplot(model_comparison, aes(
x = Model,
y = AIC
)) +
geom_col() +
labs(
title = "AIC Comparison",
subtitle = "Lower AIC is generally preferred when comparing these models",
x = "Regression Model",
y = "AIC"
) +
theme_minimal()
# ============================================================
# PART 10: Statistical test for model improvement
# ============================================================
# Tests whether adding car_age significantly improves model fit
anova(model1, model2)
# ============================================================
# PART 11: Actual vs predicted prices for Model 2
# ============================================================
cars_model <- cars_model |>
mutate(
predicted_price = predict(model2, newdata = cars_model)
)
ggplot(cars_model, aes(
x = selling_price,
y = predicted_price
)) +
geom_point(alpha = 0.25) +
geom_abline(
intercept = 0,
slope = 1,
linetype = "dashed"
) +
scale_x_continuous(labels = label_comma()) +
scale_y_continuous(labels = label_comma()) +
coord_cartesian(
xlim = c(0, 2000000),
ylim = c(0, 2000000)
) +
labs(
title = "Actual vs Predicted Selling Prices",
subtitle = "Dashed line indicates perfect predictions",
x = "Actual Selling Price (₹)",
y = "Predicted Selling Price (₹)"
) +
theme_minimal()
# ============================================================
# PART 12: Regression diagnostics for Model 2
# ============================================================
par(mfrow = c(2, 2))
plot(model2)
par(mfrow = c(1, 1))
# ============================================================
# PART 13: Save key results
# ============================================================
write_csv(
model_comparison,
"model_comparison.csv"
)
write_csv(
cars_model,
"cars_cleaned_with_predictions.csv"
)
cat("\nAnalysis completed.\n")
cat("Cleaned dataset rows:", nrow(cars_model), "\n")
cat("Model comparison saved to model_comparison.csv\n")
cat("Cleaned data saved to cars_cleaned_with_predictions.csv\n")
